
@{
    ViewData["Title"] = "Index";
}
<h1>The Company Employee List</h1>
<div class="alert alert-primary" role="alert">
    <p>@ViewBag.DailyAnnouncement</p>
</div>
<h2>Status <span class="badge text-bg-secondary bg-success">Active</span></h2>
<h4>The List of Current Employees:</h4>
@{List<ItEmployee> emps = TempData["data"] as List<ItEmployee>;}
<table class="table table-striped table-hover table-primary">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Role</th>
            <th scope="col">Salary</th>
        </tr>
    </thead>
    <tbody>
            @foreach (var e in emps)
            {
                @if(e.active){
        <tr>
            <td>@e.EmpId</td>
            <td>@e.Name</td>
            <td>@e.Jobrole</td>
            <td>@e.Salary</td> 
        </tr>
            }
            }
    </tbody>
</table>



